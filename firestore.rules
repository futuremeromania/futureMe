rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      // Initial profile doc, written by the client right after signup
      // (UserRepository.createOrUpdateProfileOnSignIn). `subscription` may
      // only be seeded at its default, unpaid value here; `retakeUsage`
      // doesn't exist yet for a brand-new account.
      allow create: if isOwner(uid)
          && (!('subscription' in request.resource.data) || request.resource.data.subscription.status == 'none')
          && !('retakeUsage' in request.resource.data);

      // `subscription` (paid access) and `retakeUsage` (monthly retake
      // quota) may only change via the trusted Cloud Functions in
      // functions/account.js — Admin SDK writes bypass these rules by
      // design, which is what those functions rely on. A user editing
      // their own document directly can change every other field but
      // not these two, so they can't grant themselves access or reset
      // their quota by hand.
      allow update: if isOwner(uid)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscription', 'retakeUsage']);

      allow delete: if false;

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
